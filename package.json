{
  "name": "position-sizer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A risk-aware, whole-share position sizing calculator",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "check": "npm run lint && npm test && npm run build && npm run test:ui",
    "format": "prettier --write src tests *.js *.json *.md index.html .github/workflows/*.yml"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "vite": "8.3.1"
  }
}
